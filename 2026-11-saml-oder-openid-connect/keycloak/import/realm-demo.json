{
  "realm": "demo",
  "enabled": true,
  "displayName": "SAML vs. OIDC Demo",
  "sslRequired": "none",
  "groups": [
    { "name": "dozierende" },
    { "name": "studierende" }
  ],
  "users": [
    {
      "username": "jane",
      "enabled": true,
      "email": "jane@example.ch",
      "emailVerified": true,
      "firstName": "Jane",
      "lastName": "Muster",
      "credentials": [ { "type": "password", "value": "jane", "temporary": false } ],
      "groups": [ "/dozierende" ]
    },
    {
      "username": "max",
      "enabled": true,
      "email": "max@example.ch",
      "emailVerified": true,
      "firstName": "Max",
      "lastName": "Beispiel",
      "credentials": [ { "type": "password", "value": "max", "temporary": false } ],
      "groups": [ "/studierende" ]
    }
  ],
  "clients": [
    {
      "clientId": "saml-vs-oidc",
      "name": "Demo-App (OpenID Connect)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "demo-secret-change-me",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [ "http://localhost:8081/login/oauth2/code/keycloak" ],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8081/"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "http://localhost:8081/saml2/service-provider-metadata/keycloak",
      "name": "Demo-App (SAML 2.0)",
      "protocol": "saml",
      "enabled": true,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:8081/login/saml2/sso/keycloak",
        "http://localhost:8081/logout/saml2/slo"
      ],
      "attributes": {
        "saml_assertion_consumer_url_post": "http://localhost:8081/login/saml2/sso/keycloak",
        "saml_single_logout_service_url_post": "http://localhost:8081/logout/saml2/slo",
        "saml_single_logout_service_url_redirect": "http://localhost:8081/logout/saml2/slo",
        "saml.force.post.binding": "true",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml.client.signature": "true",
        "saml.signing.certificate": "${SAML_SP_CERTIFICATE}",
        "saml.encrypt": "false",
        "saml.authnstatement": "true",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "username"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "friendly.name": "email",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "firstName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "attribute.name": "givenName",
            "friendly.name": "givenName",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "groups",
          "protocol": "saml",
          "protocolMapper": "saml-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "attribute.name": "groups",
            "friendly.name": "groups",
            "attribute.nameformat": "Basic",
            "full.path": "false",
            "single": "false"
          }
        }
      ]
    }
  ]
}
